# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Virtual envs
venv/
.venv/
env/

# OS
.DS_Store
Thumbs.db

# Model weights (downloaded on first use via checkpoints.ensure_checkpoint)
checkpoint/*.pth
checkpoint/*.npz

# External datasets (huge; not redistributable)
data/

# Raw signal / model-weight / dataset binaries — NEVER commit (global rule).
# Also enforced by scripts/git-hooks/pre-commit (see CLAUDE.md § no-datasets rule).
*.npy
*.npz
*.pth
*.pt
*.ckpt
*.edf
*.dat
*.hea
*.mat
*.h5
*.hdf5
*.wav

# Run logs (tqdm-spam training/eval logs; regenerable, not deliverables)
*.log
res/**/run*.log

# Large evaluation artifacts that can be regenerated
res/mitdb_standardized/
res/**/*.npy
